@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 12
skinparam ranksep 45
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #64748B
skinparam ArrowThickness 1
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #2563A6
  FontColor #183153
}
skinparam rectangle {
  BackgroundColor White
  BorderColor #2563A6
  FontColor #183153
}

!procedure $wideCase($alias, $label)
  usecase "<font:Arial>                                              $label                                              </font>" as $alias
!endprocedure

actor "Email User" as User

rectangle "CategorAIze Email Intelligence System" {
  $wideCase("U1", "Connect Email Account")
  $wideCase("U2", "Synchronize Email")
  $wideCase("U8", "Prepare Reply Draft")
  $wideCase("U10", "Send Approved Reply")
  $wideCase("U11", "Clean Up Inbox")
  $wideCase("U3", "Manage Categories")
  $wideCase("U4", "Review Email Analysis")
  $wideCase("U5", "Correct Email Classification")
  $wideCase("U6", "Search Email")
  $wideCase("U7", "Review Tasks and Deadlines")
  $wideCase("U12", "Export Deadline to Calendar")
  $wideCase("U9", "Check Calendar Availability")
  $wideCase("U13", "View Email Notifications")

  ' Hidden links control placement without adding UML relationships.
  U1 -[hidden]right- U2
  U2 -[hidden]left- U8
  U8 -[hidden]left- U10
  U10 -[hidden]left- U11
  U11 -[hidden]left- U3
  U3 -[hidden]left- U4
  U4 -[hidden]left- U5
  U5 -[hidden]left- U6
  U6 -[hidden]left- U7
  U7 -[hidden]left- U12
  U12 -[hidden]left- U9
  U9 -[hidden]left- U13
}

actor "Gmail Service" as Gmail
actor "Google Calendar Service" as Calendar

User -- U1
User -- U2
User -- U3
User -- U4
User -- U5
User -- U6
User -- U7
User -- U8
User -- U9
User -- U10
User -- U11
User -- U12
User -- U13

U1 -- Gmail
U2 -- Gmail
U8 -- Gmail
U10 -- Gmail
U11 -- Gmail
U9 -- Calendar
U12 -- Calendar
Gmail -[hidden]right- Calendar

U5 .right.> U4 : <<extend>>
U12 .right.> U7 : <<extend>>
@enduml
